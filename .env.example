# Pour activer la récupération de mot de passe, créez un mot de passe d'application Google.
# Ne mettez jamais ici le mot de passe normal de votre compte Gmail.
# Gardez ce fichier .env privé et ne l'incluez pas dans l'exécutable.
SGD_SMTP_HOST=smtp.gmail.com
SGD_SMTP_PORT=587
SGD_SMTP_USER=votre-adresse@gmail.com
SGD_SMTP_PASSWORD=votre-mot-de-passe-application-google
SGD_SMTP_FROM=votre-adresse@gmail.com
